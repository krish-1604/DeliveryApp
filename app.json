{
  "expo": {
    "name": "Delivery App",
    "slug": "delivery-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/assets/images/main-splash.png",
    "scheme": "deliveryapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./app/assets/images/main-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#003032"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/images/main-splash.png",
        "backgroundColor": "#003032"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.parker_2107.deliveryapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./app/assets/images/main-splash.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "./app"
      },
      "eas": {
        "projectId": "e4f0078d-0986-40ed-82c4-29aed7cdc09f"
      }
    }
  }
}
